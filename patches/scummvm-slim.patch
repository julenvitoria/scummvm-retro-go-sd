@@ -1156,6 +1167,17 @@ void ResourceManager::Resource::setOnHeap() {
 	_status &= ~RF_OFFHEAP;
 }
 
+#ifdef GW_SCUMM_SLIM
+// Game & Watch: the resource cache's thresholds (550 KB) are more than the whole free heap;
+// resources are also expired whenever the heap itself runs low.
+extern "C" uint32 heap_free_bytes(void);
+extern "C" int heap_can_alloc(uint32 n);
+// low: under 48 KB free besides the new resource, or no single hole it fits in
+#define GW_HEAP_LOW(size) (heap_free_bytes() < (size) + 48 * 1024 || !heap_can_alloc((size) + 64))
+#else
+#define GW_HEAP_LOW(size) false
+#endif
