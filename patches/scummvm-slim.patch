+#ifdef GW_SWORD1_SLIM
+// expandSpeech()'s CowWave case, read from _cowFile 2 KB at a time, to signed 8-bit samples
+bool Sound::gwLoadSpeech(uint32 offset, uint32 size) {
+	byte head[128];
+	uint32 n = MIN<uint32>(size, sizeof(head));
+	_cowFile.seek(offset);
+	if (_cowFile.read(head, n) != n)
+		return false;
+	uint32 pos = 0;
+	while (pos + 8 <= n && READ_BE_UINT32(head + pos) != MKTAG('d','a','t','a'))
+		pos++;
+	if (pos + 8 > n || pos >= 100) {
+		warning("Sound::gwLoadSpeech(): DATA tag not found in wave header");
+		return false;
+	}
+	int32 samples = READ_LE_UINT32(head + pos + 4) >> 1;
+	pos += 8;
+	if (samples <= 0)
+		return false;
+	int8 *dst = (int8 *)malloc(samples + 1);
+	if (!dst)
+		return false;
+	memset(dst, 0, samples + 1);
+
+	// the compressed words: a count, then that many samples, or (count < 0) one to repeat
+	enum { BUF = 2048 };
+	byte buf[BUF];
+	uint32 bufLen = 0, bufPos = 0, left = size - pos;   // bytes of the stream still in the file
+	_cowFile.seek(offset + pos);
+	auto word = [&](int16 &w) -> bool {
+		if (bufPos + 2 > bufLen) {
+			uint32 keep = bufLen - bufPos;                // (an odd byte: never, the words are aligned)
+			memmove(buf, buf + bufPos, keep);
+			uint32 get = MIN<uint32>(BUF - keep, left);
+			get = _cowFile.read(buf + keep, get);
+			left -= get;
+			bufLen = keep + get;
+			bufPos = 0;
+			if (bufLen < 2)
+				return false;
+		}
+		w = (int16)READ_LE_UINT16(buf + bufPos);
+		bufPos += 2;
+		return true;
+	};
+	int32 out = 0;
+	int16 length, value;
+	while (out < samples && word(length)) {
+		if (length < 0) {
+			int32 l = MIN<int32>(-(int32)length, samples - out);
+			if (!word(value))
+				break;
+			memset(dst + out, (int8)(value >> 8), l);
+			out += l;
+		} else {
+			int32 l = MIN<int32>(length, samples - out);
+			for (int32 i = 0; i < length; i++) {
+				if (!word(value))
+					break;
+				if (i < l)
+					dst[out + i] = (int8)(value >> 8);
+			}
+			out += l;
+		}
+	}
+	free(_speechSample);
+	_speechSample = (byte *)dst;
+	_speechSize = samples;
+	_gwSpeech8 = true;
+	return true;
