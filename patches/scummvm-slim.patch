+	for (int t = 0; t < GW_DEFERRED && t < _smushNumTracks; t++) {
+		SmushAudioTrack &trk = _smushTracks[t];
+		if (_gwPendCount[t] && (trk.state == TRK_STATE_INACTIVE || !trk.blockPtr || !_base))
+			_gwPendCount[t] = 0;
+		while (_gwPendCount[t]) {
+			const GwPend &e = _gwPend[t][_gwPendHead[t]];
+			if (!gwRoomFor(t, e.size))
+				break;
+			if (back < 0)
