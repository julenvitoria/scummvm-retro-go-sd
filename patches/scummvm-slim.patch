+#ifdef GW_SCUMM_SLIM
+// Game & Watch: the Retro-Go PAUSE/SET menu's Save and Load (src/gw_system.cpp). They are
+// called from the backend's pollEvent(), between two frames of the engine's loop -- where a
+// save requested from ScummVM's own menu would also be written, one loop later.
+bool ScummEngine::gwSaveNow(int slot, const Common::String &desc) {
+	_saveLoadDescription = desc;
+	Common::String filename;
+	return saveState(slot, false, filename);
+}
+
+} // End of namespace Scumm
+
+extern "C" int gw_scumm_save(int slot) {
+	Scumm::ScummEngine *e = static_cast<Scumm::ScummEngine *>(g_engine);
+	if (!e || !e->canSaveGameStateCurrently())
+		return 0;
+	return e->gwSaveNow(slot, "Retro-Go") ? 1 : 0;
+}
+
+extern "C" int gw_scumm_load(int slot) {
+	Scumm::ScummEngine *e = static_cast<Scumm::ScummEngine *>(g_engine);
+	if (!e || !e->canLoadGameStateCurrently())
+		return 0;
+	e->requestLoad(slot);
+	return 1;
+}
+
+namespace Scumm {
+#endif
