+// A PSAD chunk (a piece of a sound) at the stream's position. If its track's buffer has no
+// room for it yet, or earlier pieces are waiting, its place is queued and nothing is read:
+// gwPumpAudio() reads it when its turn comes. What fits right now is left to the usual path
+// (music, which comes as fast as it plays, always), as is a sound's first piece.
+bool SmushPlayer::gwQueuePSAD(Common::SeekableReadStream &b, int32 subSize) {
+	uint8 h[12];
+	const int32 pos = b.pos();
+
+	if (!_smushAudioInitialized || subSize <= 12)
+		return false;
+	if (b.read(h, 12) != 12) {
+		b.seek(pos, SEEK_SET);
+		return false;
+	}
+	// the two encodings of feedAudio()
+	uint16 trkId, index;
+	int32 maxFrames, hdr, vol, pan;
+	if (h[0] == 0 && h[1] == 0 && h[4] == 0 && h[5] == 0 && h[8] == 0 && h[9] == 0) {
+		trkId = READ_BE_INT16(h + 2);
+		index = READ_BE_INT16(h + 6);
+		maxFrames = READ_BE_INT16(h + 10);
+		hdr = 12;
+		vol = 127;
+		pan = 0;
+	} else {
+		trkId = READ_LE_INT16(h);
+		index = READ_LE_INT16(h + 2);
+		maxFrames = READ_LE_INT16(h + 4);
+		hdr = 10;
+		vol = (((127 * h[8]) >> 7) * h[8]) >> 7;
+		pan = h[9];
+	}
+	const uint32 size = subSize - hdr;
+	int t = -1;
+	for (int i = 0; index && i < _smushNumTracks; i++) {
+		if (_smushTracks[i].state != TRK_STATE_INACTIVE && trkId == _smushTrackIds[i] &&
+		    index == (_smushTrackIdxs[i] + 1) && maxFrames == _smushMaxFrames[i]) {
+			t = i;
+			break;
+		}
+	}
+	if (t == -1 || _gwPendCount[t] >= _gwPendCap[t] || (!_gwPendCount[t] && gwRoomFor(t, size))) {
+		b.seek(pos, SEEK_SET);
+		return false;
+	}
+	GwPend &e = _gwPend[t][(_gwPendHead[t] + _gwPendCount[t]) % _gwPendCap[t]];
+	e.off = pos + hdr;
+	e.size = size;
+	_gwPendCount[t]++;
+	_smushTrackIdxs[t]++;
+	if (vol >= 0 && vol < 128)
+		_smushTracks[t].volume = vol;
+	if (pan > -128 && pan < 128)
+		_smushTracks[t].pan = pan;
+	return true;
+}
+
+void SmushPlayer::gwPumpAudio() {
+	int32 back = -1;
+
+	for (int t = 0; t < GW_DEFERRED && t < _smushNumTracks; t++) {
+		SmushAudioTrack &trk = _smushTracks[t];
+		if (_gwPendCount[t] && (trk.state == TRK_STATE_INACTIVE || !trk.blockPtr || !_base))
+			_gwPendCount[t] = 0;
+		while (_gwPendCount[t]) {
+			const GwPend &e = _gwPend[t][_gwPendHead[t]];
+			if (!gwRoomFor(t, e.size))
+				break;
+			if (back < 0)
+				back = _base->pos();
+			uint32 mod = trk.availableSize % trk.dataSize;
+			uint32 first = MIN<uint32>(e.size, trk.dataSize - mod);
+			_base->seek(e.off, SEEK_SET);
+			_base->read(&trk.subChunkPtr[mod], first);
+			if (first < e.size)
+				_base->read(trk.subChunkPtr, e.size - first);
+			trk.availableSize += e.size;
+			_gwPendHead[t] = (_gwPendHead[t] + 1) % _gwPendCap[t];
+			_gwPendCount[t]--;
+		}
+	}
+	if (back >= 0)
+		_base->seek(back, SEEK_SET);
+}
