+// every file of 'archive' into the folder 'dir' (which exists), as it is; progress(compressed
+// bytes read so far) after each file. False: the archive or a file could not be read/written.
+bool gwArjExtract(const Path &archive, const char *dir, void (*progress)(uint32 done, void *arg), void *arg) {
+	File arjFile;
+	if (!arjFile.open(archive))
+		return false;
+	int32 first = findHeader(arjFile);
+	if (first < 0)
+		return false;
+	arjFile.seek(first, SEEK_SET);
+	ArjHeader *header = readHeader(arjFile);
+	if (!header)
+		return false;
+	delete header;
+	uint32 done = 0;
+	bool ok = true;
+	// progress while a file is decoded too (the animations are up to 4 MB: minutes on the
+	// console with nothing moving on screen)
+	struct Tick {
+		File *f;
+		uint32 base;
+		int64 start;
+		void (*progress)(uint32, void *);
+		void *arg;
+		static void call(void *p) {
+			Tick *t = (Tick *)p;
+			if (t->progress)
+				t->progress(t->base + (uint32)(t->f->pos() - t->start), t->arg);
+		}
+	} tick = { &arjFile, 0, 0, progress, arg };
+	while (ok && (header = readHeader(arjFile)) != nullptr) {
+		tick.base = done;
+		tick.start = arjFile.pos();
+		const char *name = header->filename;
+		for (const char *p = header->filename; *p; p++)
+			if (*p == '\\' || *p == '/')
+				name = p + 1;
+		String path = String::format("%s/%s", dir, name);
+		void *f = plat_fopen(path.c_str(), "wb");
+		int64 next = arjFile.pos() + header->compSize;
+		if (!f) {
+			ok = false;
+		} else {
+			GWPlatWriteStream out(f);
+			out._tick = Tick::call;
+			out._tickArg = &tick;
+			if (header->method == 0) {
+				byte buf[1024];
+				for (int32 left = header->origSize; left > 0 && ok;) {
+					uint32 k = MIN<int32>(left, sizeof(buf));
+					ok = arjFile.read(buf, k) == k && out.write(buf, k) == k;
+					left -= k;
+				}
+			} else {
+				ArjDecoder *decoder = new ArjDecoder(header);
+				decoder->_compressed = wrapBufferedReadStream(&arjFile, 4096, DisposeAfterUse::NO);
+				decoder->_outstream = &out;
+				if (header->method == 1 || header->method == 2 || header->method == 3)
+					decoder->decode(header->origSize);
+				else if (header->method == 4)
+					decoder->decode_f(header->origSize);
+				else
+					ok = false;
+				decoder->_outstream = nullptr;
+				delete decoder;
+			}
+			ok = ok && out.flush() && out.pos() == header->origSize;
+			plat_fclose(f);
+		}
+		done += header->compSize;
+		delete header;
+		arjFile.seek(next, SEEK_SET);
+		if (progress)
+			progress(done, arg);
+	}
+	return ok;
+}
