+// Game & Watch: a file is looked for on the card when it is asked for, instead of in a
+// listing of the whole tree kept in memory (~190 bytes a file: 40 KB for Full Throttle's
+// DATA and VIDEO folders); only what is found is kept. Flat directories, and listings
+// (listMembers & co., which call ensureCached() themselves), still cache everything.
+FSNode *FSDirectory::gwProbe(NodeCache &cache, const Path &name) const {
+	if (cache.contains(name))
+		return &cache[name];
+	Path rel = name;
+	if (!_prefix.empty()) {
+		if (!name.isRelativeTo(_prefix))
+			return nullptr;
+		rel = name.relativeTo(_prefix);
+	}
+	StringArray comps = rel.splitComponents();
+	if (comps.empty() || (int)comps.size() > _depth)
+		return nullptr;
+	FSNode node = _node;
+	for (const auto &c : comps) {
+		if (c.empty() || c == "." || c == "..")
+			return nullptr;
+		node = node.getChild(c);
+		if (!node.exists())
+			return nullptr;
+	}
+	if (node.isDirectory() != (&cache == &_subDirCache))
+		return nullptr;
+	cache[name] = node;
+	return &cache[name];
+}
+#endif
