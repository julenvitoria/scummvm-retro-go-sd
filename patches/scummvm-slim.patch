 namespace Sword1 {
 
+#ifdef GW_SWORD1_SLIM
+// Game & Watch: the control panel's 640x480 picture is kept at half size (75 KB, not 300),
+// as the console shows it. The panel's code writes through a GWDst where it had a pointer
+// into the picture: the pixels at even coordinates land in the half-size one.
+struct GWDst {
+	uint8 *buf = nullptr;
+	int32 off = 0;
+	GWDst() {}
+	explicit GWDst(uint8 *b, int32 o = 0) : buf(b), off(o) {}
+	struct Pix {
+		uint8 *buf;
+		int32 off;
+		Pix &operator=(uint8 v) {
+			if (off >= 0) {
+				int32 y = off / SCREEN_WIDTH, x = off - y * SCREEN_WIDTH;
+				if (!((x | y) & 1) && y < SCREEN_FULL_DEPTH)
+					buf[(y >> 1) * (SCREEN_WIDTH / 2) + (x >> 1)] = v;
+			}
+			return *this;
+		}
+	};
+	Pix operator[](int32 i) const { return Pix{buf, off + i}; }
+	Pix operator*() const { return Pix{buf, off}; }
+	GWDst operator+(int32 i) const { return GWDst(buf, off + i); }
+	GWDst &operator+=(int32 i) { off += i; return *this; }
+	GWDst &operator-=(int32 i) { off -= i; return *this; }
+	GWDst &operator++() { off++; return *this; }
+	GWDst operator++(int) { GWDst t = *this; off++; return t; }
+};
+inline void gwMemcpy(GWDst d, const uint8 *s, int32 n) {
+	for (int32 i = 0; i < n; i++)
+		d[i] = s[i];
+}
+#define GWDST GWDst
+#define GWSB GWDst(_screenBuf)
+#define GWMEMCPY(d, s, n) gwMemcpy(d, s, n)
+#define GW_CP_SIZE(depth) ((SCREEN_WIDTH / 2) * ((depth) / 2))
+#define GWCP_COPY(y, depth) gwCopyRectHalf(_screenBuf, SCREEN_WIDTH / 2, 0, (y) / 2, SCREEN_WIDTH / 2, (depth) / 2)
+#else
+#define GWDST uint8 *
+#define GWSB _screenBuf
+#define GWMEMCPY(d, s, n) memcpy(d, s, n)
+#define GW_CP_SIZE(depth) (SCREEN_WIDTH * (depth))
+#define GWCP_COPY(y, depth) _system->copyRectToScreen(_screenBuf, SCREEN_WIDTH, 0, y, SCREEN_WIDTH, depth)
+#endif
