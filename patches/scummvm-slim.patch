+#ifdef GW_QUEEN_SLIM
+bool Display::gwDecodePCXFile(const char *name, uint8 *dst, uint16 dstPitch, uint16 *w, uint16 *h, uint8 *pal, uint16 palStart, uint16 palEnd) {
+	Resource *res = _vm->resource();
+	ResourceEntry re;
+	res->gwFindEntry(name, &re);
+	uint8 hdr[128];
+	if (re.size < 128 + 769)
+		return false;
+	res->gwReadAt(re, 0, hdr, 128);
+	if (hdr[3] != 8 || hdr[65] != 1)
+		return false;
+	uint16 pw = READ_LE_UINT16(hdr + 8) - READ_LE_UINT16(hdr + 4) + 1;
+	uint16 ph = READ_LE_UINT16(hdr + 10) - READ_LE_UINT16(hdr + 6) + 1;
+	uint16 bpl = READ_LE_UINT16(hdr + 66);
+	uint32 pos = 128, end = re.size - 769;
+	uint8 buf[1024];
+	uint32 have = 0, at = 0;
+	for (uint16 y = 0; y < ph; y++) {
+		uint8 *row = dst + y * dstPitch;
+		uint16 x = 0;
+		while (x < bpl) {
+			if (at == have) {
+				if (pos >= end)
+					break;
+				have = MIN<uint32>(sizeof(buf), end - pos);
+				res->gwReadAt(re, pos, buf, have);
+				pos += have;
+				at = 0;
+			}
+			uint8 b = buf[at++], n = 1;
+			if ((b & 0xC0) == 0xC0) {
+				n = b & 0x3F;
+				if (at == have) {
+					if (pos >= end)
+						break;
+					have = MIN<uint32>(sizeof(buf), end - pos);
+					res->gwReadAt(re, pos, buf, have);
+					pos += have;
+					at = 0;
+				}
+				b = buf[at++];
+			}
+			while (n-- && x < bpl) {
+				if (x < pw)
+					row[x] = b;
+				x++;
+			}
+		}
+	}
+	*w = pw;
+	*h = ph;
+	assert(palStart <= palEnd && palEnd <= 256);
+	res->gwReadAt(re, re.size - 768 + palStart * 3, pal, (palEnd - palStart) * 3);
+	return true;
