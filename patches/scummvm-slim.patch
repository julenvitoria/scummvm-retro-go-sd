 			break;
 		nukeResource(best_type, best_res);
-	} while (size + _allocatedSize > _minHeapThreshold);
+	} while (size + _allocatedSize > _minHeapThreshold || GW_HEAP_LOW(size));
 
 	increaseResourceCounters();
 
