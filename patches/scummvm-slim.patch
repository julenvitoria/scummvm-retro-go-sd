+bool Screen::gwDrawTony(const uint8 *src, uint32 compSize, int w, int h, int x, int y) {
+	static uint8 row[1024];
+	if (w <= 0 || w > (int)sizeof(row))
+		return false;
+	const uint8 *end = src + compSize;
+	int col = 0, r = 0;
+	auto put = [&](const uint8 *p, uint8 c, int n, bool flat) {
+		while (n > 0 && r < h) {
+			int k = MIN(n, w - col);
+			if (flat)
+				memset(row + col, c, k);
+			else {
+				memcpy(row + col, p, k);
+				p += k;
+			}
+			col += k;
+			n -= k;
+			if (col == w) {
+				gwSpan(x, y + r, row, w, true);
+				col = 0;
+				r++;
+			}
+		}
+	};
+	while (src < end && r < h) {
+		uint8 numFlat = *src++;
+		if (numFlat) {
+			put(nullptr, *src, numFlat, true);
+			src++;
+		}
+		if (src < end) {
+			uint8 numNoFlat = *src++;
+			put(src, 0, numNoFlat, false);
+			src += numNoFlat;
+		}
+	}
+	return true;
