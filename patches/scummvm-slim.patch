+uint8 *IMuseDigiFilesHandler::soundData(int soundId, int32 offset, int32 len) {
+#ifdef GW_V7_SLIM
+	// Game & Watch: a big sound resource (Full Throttle's engine noises and ambiences, up to
+	// ~250 KB each) not in memory is played from the card through a few small windows
+	// instead of being loaded whole: the dispatch only ever wants a feed's worth of it
+	uint32 offs, size;
+	if (soundId && !_engine->isEngineDisabled() && _vm->gwSoundOnCard(soundId, offs, size)) {
+		if (offset < 0 || (uint32)offset >= size || len < 0 || len > GW_SD_WIN)
+			return nullptr;
+		GWWindow *w = nullptr, *victim = nullptr;
+		for (auto &cur : _gwWin) {
+			if (cur.buf && cur.soundId == soundId && offset >= cur.base && offset + len <= cur.base + GW_SD_WIN) {
+				w = &cur;
+				break;
+			}
+			// refill this sound's own window (it moves forward), else the least recently used
+			if (cur.soundId == soundId)
+				victim = &cur;
+		}
+		if (!w) {
+			if (!victim) {
+				victim = &_gwWin[0];
+				for (auto &cur : _gwWin)
+					if (cur.stamp < victim->stamp)
+						victim = &cur;
+			}
+			w = victim;
+			if (!w->buf)
+				w->buf = (uint8 *)malloc(GW_SD_WIN);
+			if (!w->buf)
+				return nullptr;
+			int32 n = MIN<uint32>(GW_SD_WIN, size - offset);
+			int got = _vm->gwReadSoundResource(offs + offset, w->buf, n);
+			if (got < 0)
+				got = 0;
+			memset(w->buf + got, 0, GW_SD_WIN - got);
+			w->soundId = soundId;
+			w->base = offset;
+		}
+		w->stamp = ++_gwWinStamp;
+		return w->buf + (offset - w->base);
+	}
+#endif
+	uint8 *ptr = getSoundAddrData(soundId);
+	return ptr ? ptr + offset : nullptr;
+}
