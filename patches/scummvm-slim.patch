+class GWFrameReader {
+	Common::SeekableReadStream *_s;
+	uint32 _left;
+	byte _buf[2048];
+	uint32 _at = 0, _have = 0;
+public:
+	GWFrameReader(Common::SeekableReadStream *s, uint32 len) : _s(s), _left(len) {}
+	bool done() const { return _at == _have && !_left; }
+	byte get() {
+		if (_at == _have) {
+			if (!_left)
+				return 0;
+			_have = _s->read(_buf, MIN<uint32>(_left, sizeof(_buf)));
+			if (!_have) {
+				_left = 0;
+				return 0;
+			}
+			_left -= _have;
+			_at = 0;
+		}
+		return _buf[_at++];
+	}
+	void finish() {
+		if (_left)
+			_s->skip(_left);
+		_left = 0;
+	}
