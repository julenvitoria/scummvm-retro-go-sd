+static uint32 gwNameHash(const Common::String &s) {
+	uint32 h = 2166136261u;
+	for (uint i = 0; i < s.size(); i++)
+		{ byte ch = (byte)s[i]; if (ch >= 'a' && ch <= 'z') ch -= 32; h = (h ^ ch) * 16777619u; }
+	return h;
+}
+
+const PlainArchive::GWEnt *PlainArchive::gwFind(const Common::Path &path) const {
+	Common::String s = path.toString('/');
+	uint32 h = gwNameHash(s);
+	for (uint i = _ents.size(); i-- > 0;)        // the last one added wins, as the HashMap did
+		if (_ents[i].hash == h && !scumm_stricmp(&_names[_ents[i].name], s.c_str()))
+			return &_ents[i];
+	return nullptr;
+}
+
+bool PlainArchive::hasFile(const Common::Path &path) const {
+	return gwFind(path) != nullptr;
+}
+
+int PlainArchive::listMembers(Common::ArchiveMemberList &list) const {
+	int count = 0;
+	for (uint i = 0; i < _ents.size(); ++i) {
+		const char *n = &_names[_ents[i].name];
+		if (gwFind(Common::Path(n)) != &_ents[i])  // a name added again later: once
+			continue;
+		list.push_back(Common::ArchiveMemberList::value_type(new Common::GenericArchiveMember(Common::Path(n), *this)));
+		++count;
+	}
+	return count;
+}
