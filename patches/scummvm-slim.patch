+// Game & Watch: a file of the archive written to the card as it is decoded (4 KB at a time)
+class GWPlatWriteStream : public WriteStream {
+	void *_f;
+	byte _buf[4096];
+	uint32 _n = 0, _pos = 0;
+	bool _err = false;
+public:
+	void (*_tick)(void *) = nullptr;		// after every 4 KB written
+	void *_tickArg = nullptr;
+	GWPlatWriteStream(void *f) : _f(f) {}
+	~GWPlatWriteStream() override { flush(); }
+	uint32 write(const void *dataPtr, uint32 dataSize) override {
+		const byte *p = (const byte *)dataPtr;
+		for (uint32 left = dataSize; left;) {
+			uint32 k = MIN<uint32>(left, sizeof(_buf) - _n);
+			memcpy(_buf + _n, p, k);
+			_n += k; p += k; left -= k;
+			if (_n == sizeof(_buf) && !flush())
+				return 0;
+		}
+		_pos += dataSize;
+		return dataSize;
+	}
+	bool flush() override {
+		if (_n && plat_fwrite(_buf, _n, _f) != _n)
+			_err = true;
+		_n = 0;
+		if (_tick)
+			_tick(_tickArg);
+		return !_err;
+	}
+	bool err() const override { return _err; }
+	int64 pos() const override { return _pos; }
+};
