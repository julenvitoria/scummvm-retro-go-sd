+bool SmushPlayer::gwRoomFor(int t, uint32 size) {
+	const SmushAudioTrack &trk = _smushTracks[t];
+	int32 played = (trk.state == TRK_STATE_FADING) ? 0 : _smushDispatch[t].audioRemaining;
