+		uint16 ph = READ_LE_UINT16(src + 10) - READ_LE_UINT16(src + 6) + 1;
+		uint16 bpl = READ_LE_UINT16(src + 66);
+		const uint8 *p = src + 128, *end = src + srcSize - 769;
+		for (uint16 y = 0; y < ph; y++) {
+			uint8 *row = dst + y * dstPitch;
+			uint16 x = 0;
+			while (x < bpl && p < end) {
+				uint8 b = *p++, n = 1;
+				if ((b & 0xC0) == 0xC0) {
+					n = b & 0x3F;
+					b = (p < end) ? *p++ : 0;
