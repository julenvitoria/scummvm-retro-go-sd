 	do {
 		best_type = rtInvalid;
 		best_counter = 2;
+#ifdef GW_SCUMM_SLIM
+		// Game & Watch: short of memory, what was used a moment ago (the room being left)
+		// goes too, as long as it is not in use
+		if (GW_HEAP_LOW(size))
+			best_counter = 1;
+#endif
 
 		for (ResType type = rtFirst; type <= rtLast; type = ResType(type + 1)) {
 			if (_types[type]._mode != kDynamicResTypeMode) {
@@ -1196,10 +1228,23 @@ void ResourceManager::expireResources(uint32 size) {
 		if (!best_type)
 			break;
 		nukeResource(best_type, best_res);
-	} while (size + _allocatedSize > _minHeapThreshold);
+	} while (size + _allocatedSize > _minHeapThreshold || GW_HEAP_LOW(size));
 
 	increaseResourceCounters();
 
+#ifdef GW_DEBUG_EXPIRE
+	if (GW_HEAP_LOW(size)) {
+		warning("expire: still low for %u, resources %u -> %u", size, oldAllocatedSize, _allocatedSize);
+		for (ResType type = rtFirst; type <= rtLast; type = ResType(type + 1)) {
+			ResId idx = _types[type].size();
+			while (idx-- > 0) {
+				Resource &tmp = _types[type][idx];
+				if (tmp._address)
+					warning("  type %d idx %d size %u locked %d counter %d inuse %d mode %d", type, idx, tmp._size, tmp.isLocked(), tmp.getResourceCounter(), _vm->isResourceInUse(type, idx), _types[type]._mode);
+			}
+		}
+	}
+#endif
 	debugC(DEBUG_RESOURCE, "Expired resources, mem %d -> %d", oldAllocatedSize, _allocatedSize);
 }
 
