+	if (h[0] == 0 && h[1] == 0 && h[4] == 0 && h[5] == 0 && h[8] == 0 && h[9] == 0) {
+		trkId = READ_BE_INT16(h + 2);
+		index = READ_BE_INT16(h + 6);
+		maxFrames = READ_BE_INT16(h + 10);
+		hdr = 12;
+		vol = 127;
+		pan = 0;
+	} else {
+		trkId = READ_LE_INT16(h);
+		index = READ_LE_INT16(h + 2);
+		maxFrames = READ_LE_INT16(h + 4);
