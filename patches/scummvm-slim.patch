+#define GW_UNPACK_DIR "gwx"
+#define GW_UNPACK_DONE "gwx/gwx.ok"
+#define GW_UNPACK_VERSION "1"
+
+// the unpacked files, found by asking the card (a directory listing of 1,100 files in memory
+// would cost what the archives' index did)
+class GWUnpackedDir : public Common::Archive {
+	Common::String _dir;
+	Common::Path full(const Common::Path &path) const {
+		return Common::Path(_dir + "/" + path.getLastComponent().toString(), '/');
+	}
+public:
+	GWUnpackedDir(const Common::String &dir) : _dir(dir) {}
+	bool hasFile(const Common::Path &path) const override {
+		return Common::FSNode(full(path)).exists();
+	}
+	int listMembers(Common::ArchiveMemberList &list) const override { return 0; }
+	const Common::ArchiveMemberPtr getMember(const Common::Path &path) const override {
+		if (!hasFile(path))
+			return Common::ArchiveMemberPtr();
+		return Common::ArchiveMemberPtr(new Common::GenericArchiveMember(path, *this));
+	}
+	Common::SeekableReadStream *createReadStreamForMember(const Common::Path &path) const override {
+		Common::FSNode node(full(path));
+		return node.exists() ? node.createReadStream() : nullptr;
+	}
+};
+
+struct GWUnpackProgress {
+	uint32 before, total;
+	int last;
+};
+
+static void gwUnpackProgress(uint32 done, void *arg) {
+	GWUnpackProgress *p = (GWUnpackProgress *)arg;
+	int pct = (int)((uint64)(p->before + done) * 100 / (p->total ? p->total : 1));
+	if (pct != p->last) {
+		if (pct / 10 != p->last / 10)
+			warning("Drascula: unpacking the archives, %d%%", pct);	// (scummvm.log)
+		p->last = pct;
+		plat_progress(pct);
+	}
+}
+
+bool ArchiveMan::gwUnpacked(const Common::Array<Common::Path> &archives) {
+	Common::String game(plat_game_path());
+	Common::String dir = game + "/" GW_UNPACK_DIR, done = game + "/" GW_UNPACK_DONE;
+	char mark[8] = "";
+	void *f = plat_fopen(done.c_str(), "rb");
+	if (f) {
+		mark[plat_fread(mark, sizeof(mark) - 1, f)] = 0;
+		plat_fclose(f);
+	}
+	if (strcmp(mark, GW_UNPACK_VERSION)) {
+		// in the order the engine registers them: a later archive's file replaces an earlier one's
+		// (packet.004's Spanish files over packet.001's)
+		GWUnpackProgress prog = { 0, 0, -1 };
+		for (uint i = 0; i < archives.size(); i++) {
+			Common::File a;
+			if (a.open(archives[i]))
+				prog.total += a.size();
+		}
+		warning("Drascula: unpacking %u archives into %s (first start only)", archives.size(), dir.c_str());
+		plat_progress(0);
+		plat_mkdir(dir.c_str());
+		for (uint i = 0; i < archives.size(); i++) {
+			Common::File a;
+			uint32 size = a.open(archives[i]) ? a.size() : 0;
+			a.close();
+			if (!Common::gwArjExtract(archives[i], dir.c_str(), gwUnpackProgress, &prog)) {
+				warning("Drascula: could not unpack %s into %s (room on the card?)", archives[i].toString().c_str(), dir.c_str());
+				return false;
+			}
+			prog.before += size;
+		}
+		f = plat_fopen(done.c_str(), "wb");
+		if (!f || plat_fwrite(GW_UNPACK_VERSION, 1, f) != 1) {
+			if (f)
+				plat_fclose(f);
+			return false;
+		}
+		plat_fclose(f);
+		plat_progress(100);
+		warning("Drascula: unpacked");
+	}
+	add(GW_UNPACK_DIR, new GWUnpackedDir(dir), 10);
+	return true;
+}
