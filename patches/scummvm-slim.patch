+void GwVgaStream::start(MemoryBlock *src) {
+	_d = src->data();
+	_size = src->size();
+	_p1 = READ_LE_UINT32(_d + 0x400);
+	_p2 = 0x404;
+	_ch = _p2 < _size ? _d[_p2++] : 0;
+	_cl = 9;
+	_bp = 0;
+	_run = 0;
+	_outer = true;
+	_done = _size < 0x405;
+	pos = 0;
+}
+
+bool GwVgaStream::bit() {
+	if (--_cl == 0) {
+		_ch = _p2 < _size ? _d[_p2++] : 0;
+		_cl = 8;
+	}
+	bool r = (_ch & 0x80) != 0;
+	_ch <<= 1;
+	return r;
+}
+
+// PictureDecoder::gwVgaLoop(), turned inside out
+int GwVgaStream::next() {
+	if (_run) {
+		_run--;
+		pos++;
+		return _runVal;
+	}
+	byte al;
+	for (;;) {
+		if (_done)
+			return -1;
+		if (_outer) {
+			al = in1();
+			_outer = false;
+			break;
+		}
+		if (bit()) {
+			if (bit()) {
+				if (bit()) {
+					_outer = true;
+					continue;
+				}
+				al = _d[_bp + 3];
+			} else
+				al = bit() ? _d[_bp + 2] : _d[_bp + 1];
+		} else if (bit()) {
+			byte n = in1();
+			if (n == 0) {
+				if (in1() == 0)
+					_done = true;
+				continue;
+			}
+			_runVal = (byte)(_bp >> 2);
+			_run = n - 1;
+			pos++;
+			return _runVal;
+		} else
+			al = _d[_bp];
+		break;
+	}
+	_bp = ((uint32)al) << 2;
+	pos++;
