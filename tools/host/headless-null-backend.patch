+// ---- headless test harness (scummvm-retro-go-sd study): frames to PPM + scripted input ----
+#include "graphics/surface.h"
+class HeadlessGraphics : public NullGraphicsManager {
+public:
+	Graphics::Surface _s; byte _pal[768]; uint32 _next = 0, _every = 0; int _n = 0; const char *_dir;
+	HeadlessGraphics() { memset(_pal, 0, sizeof _pal); _dir = getenv("HL_SHOTS"); const char *e = getenv("HL_EVERY"); _every = e ? atoi(e) : 1000; }
+	void initSize(uint w, uint h, const Graphics::PixelFormat *f) override {
+		NullGraphicsManager::initSize(w, h, f); _s.free(); _s.create(w, h, Graphics::PixelFormat::createFormatCLUT8()); }
+	void setPalette(const byte *c, uint start, uint num) override { memcpy(_pal + start * 3, c, num * 3); }
+	void grabPalette(byte *c, uint start, uint num) const override { memcpy(c, _pal + start * 3, num * 3); }
+	void copyRectToScreen(const void *buf, int pitch, int x, int y, int w, int h) override { _s.copyRectToSurface(buf, pitch, x, y, w, h); }
+	Graphics::Surface *lockScreen() override { return &_s; }
+	void fillScreen(uint32 col) override { _s.fillRect(Common::Rect(_s.w, _s.h), col); }
+	void updateScreen() override {
+		if (!_dir || !_s.getPixels()) return;
+		uint32 now = g_system->getMillis();
+		if (now < _next) return;
+		_next = now + _every;
+		char path[512]; snprintf(path, sizeof path, "%s/f%05u.ppm", _dir, now / 100);
+		FILE *f = fopen(path, "wb"); if (!f) return;
+		fprintf(f, "P6\n%d %d\n255\n", _s.w, _s.h);
+		for (int yy = 0; yy < _s.h; yy++) for (int xx = 0; xx < _s.w; xx++) { byte i = *(const byte *)_s.getBasePtr(xx, yy); fwrite(_pal + i * 3, 1, 3, f); }
+		fclose(f);
+	}
+};
+// HL_EVENTS="ms:k:<ascii>;ms:c:x,y;ms:r:x,y;ms:m:x,y;ms:q" (key, left click, right click, move, quit)
+static bool hl_event(Common::Event &event, uint32 now) {
+	static const char *p = getenv("HL_EVENTS"); static int pending = 0; static Common::Event up;
+	if (pending) { event = up; pending = 0; return true; }
+	if (!p || !*p) return false;
+	uint32 t = strtoul(p, 0, 10); if (now < t) return false;
+	const char *c = strchr(p, ':'); if (!c) { p = 0; return false; }
+	char kind = c[1]; const char *a = c + 3; int x = 0, y = 0;
+	if (kind == 'k') {
+		event.type = Common::EVENT_KEYDOWN; event.kbd = Common::KeyState((Common::KeyCode)a[0], a[0]);
+		up = event; up.type = Common::EVENT_KEYUP; pending = 1;
+	} else if (kind == 'q') { event.type = Common::EVENT_QUIT; }
+	else {
+		sscanf(a, "%d,%d", &x, &y); event.mouse = Common::Point(x, y);
+		event.type = kind == 'm' ? Common::EVENT_MOUSEMOVE : kind == 'c' ? Common::EVENT_LBUTTONDOWN : Common::EVENT_RBUTTONDOWN;
+		if (kind != 'm') { up = event; up.type = kind == 'c' ? Common::EVENT_LBUTTONUP : Common::EVENT_RBUTTONUP; pending = 1; }
+	}
+	const char *n = strchr(p, ';'); p = n ? n + 1 : "";
+	return true;
+}
